# WaterAI Konfiguratsiya fayli namuna (.env.example)

# Ma'lumotlar bazasi (standart: SQLite)
DATABASE_URL=sqlite:///./waterai.db

# JWT xavfsizlik kaliti
JWT_SECRET=waterai-secret-key-2026-super-secure

# Bosh Administrator hisobi (standart)
ADMIN_PHONE=+998938554640
ADMIN_PASSWORD=123456
ADMIN_NAME=Bosh Administrator

# PH-W218 (Tuya) suv sifati qurilmasi — lokal tarmoq orqali ulanish
TUYA_DEVICE_ID=your_device_id_here
TUYA_LOCAL_KEY=your_local_key_here
TUYA_DEVICE_IP=172.16.0.86
TUYA_VERSION=3.5
POLL_INTERVAL=2
